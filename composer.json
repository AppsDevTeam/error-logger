{
	"name": "adt/error-logger",
	"type": "library",
	"description": "",
	"keywords": ["nette", "error", "logger", "errorLogger"],
	"license": ["BSD-3-Clause", "GPL-2.0", "GPL-3.0"],
	"authors": [
		{
			"name": "Apps Dev Team",
			"homepage": "https://www.appsdevteam.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"tracy/tracy": ">=2.6.0"
	},
	"suggest": {
		"adt/tracy-git": "Useful for displaying information about currently deployed application version."
	},
	"autoload": {
		"psr-4": {
			"ADT\\": "src/"
		}
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6 | ^10.5 | ^11.5 | ^12.0"
	},
	"autoload-dev": {
		"psr-4": {
			"ADT\\ErrorLogger\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	}
}
